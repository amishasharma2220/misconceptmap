# Copy to .env for local development. On the live server, set these in the host's dashboard.

# "development" locally. On the live server set ENVIRONMENT=production: the API then refuses
# to start unless JWT_SECRET, CORS_ORIGINS and DATABASE_URL below are safe.
ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg://mm:mm@localhost:5432/misconceptmap

# Signs login tokens. Production needs a private random string of 32+ characters:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-secret-change-me-before-deploying-0000

# Addresses allowed to call the API, comma-separated. In production: only the live site,
# for example https://misconceptmap.example
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Free key: https://aistudio.google.com/apikey  (empty = basic coach, no tag drafting)
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash

# Countdown on the dashboard; update when the official GATE 2027 date is announced.
GATE_DATE=2027-02-06
